{"scenes":[{"id":"scene-1","type":"avatar_intro","title":"Liderança pedagógica","subtitle":"O que de fato muda na sua gestão","src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-1.mp4","audioSrc":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-1.mp3","speechStartFrame":0,"speechEndFrame":473,"seconds":16.085,"durationInFrames":483,"fromFrame":0},{"id":"scene-2","type":"scenario_card","title":"Imagine","subtitle":"A reunião pedagógica vira lista de avisos e combinados operacionais.","src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-2.mp3","speechStartFrame":0,"speechEndFrame":673,"seconds":22.76,"durationInFrames":692,"fromFrame":483},{"id":"scene-3","type":"comparison_motion","title":"Urgente x Importante","left":{"items":["bebedouro quebrado","ata até sexta","resposta a imprevisto"],"title":"Gestão operacional"},"right":{"items":["foco na sala","desenvolver professores","acompanhar aprendizagem"],"title":"Liderança pedagógica"},"src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-3.mp3","speechStartFrame":0,"speechEndFrame":740,"seconds":25.08,"durationInFrames":761,"fromFrame":1175},{"id":"scene-4","type":"definition_card","title":"O termo","term":"Liderança pedagógica","definition":"Tornar a aprendizagem o critério que orienta agenda, decisões e acompanhamento.","src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-4.mp3","speechStartFrame":0,"speechEndFrame":664,"seconds":22.48,"durationInFrames":683,"fromFrame":1936},{"id":"scene-5","type":"concept_reveal","title":"Onde isso aparece","bullets":["direção explícita","foco na sala","decidir por evidências"],"src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-5.mp3","speechStartFrame":0,"speechEndFrame":732,"seconds":24.84,"durationInFrames":754,"fromFrame":2619},{"id":"scene-6","type":"myth_truth","title":"Quebra de equívoco","myth":"Resultado ruim serve para cobrar mais comprometimento.","truth":"Dado serve para diagnosticar e planejar a intervenção.","src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-6.mp3","speechStartFrame":0,"speechEndFrame":835,"seconds":28.12,"durationInFrames":853,"fromFrame":3373},{"id":"scene-7","type":"steps_flow","title":"Dado vira ação","items":["organize por área","equipe levanta hipóteses","priorize e planeje","marque data de revisão","observar"],"src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-7.mp3","speechStartFrame":0,"speechEndFrame":652,"seconds":22.2,"durationInFrames":675,"fromFrame":4226},{"id":"scene-8","type":"reflection_prompt","title":"O espectador confronta quanto tempo real dedica ao pedagógico","prompt":"Quantas horas da sua semana são realmente sobre ensino?","tag":"Pra pensar","src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-8.mp3","speechStartFrame":0,"speechEndFrame":591,"seconds":20,"durationInFrames":609,"fromFrame":4901},{"id":"scene-9","type":"maturity_ladder","title":"Maturidade da liderança","rungs":["inicial","gestor faz sozinho","prioridade compartilhada","equipe analisa junto","liderança distribuída"],"target":4,"src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-9.mp3","speechStartFrame":0,"speechEndFrame":716,"seconds":24.28,"durationInFrames":737,"fromFrame":5510},{"id":"scene-10","type":"icon_story","title":"O que sustenta o foco","items":["proteger tempo pedagógico","observar e devolver","construir liderança coletiva"],"src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-10.mp3","speechStartFrame":0,"speechEndFrame":847,"seconds":28.68,"durationInFrames":869,"fromFrame":6247},{"id":"scene-11","type":"quote_spotlight","title":"Escola que decai com a saída do gestor construiu dependência","subtitle":"Mentora Vertho","quote":"Escola que decai quando o gestor sai construiu dependência, não liderança.","src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-11.mp3","speechStartFrame":0,"speechEndFrame":721,"seconds":24.48,"durationInFrames":743,"fromFrame":7116},{"id":"scene-12","type":"avatar_outro","title":"Sua próxima ação","subtitle":"Qual prioridade pedagógica você vai proteger na agenda da próxima semana?","src":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-12.mp4","audioSrc":"https://xwuqrgrvakxtphbmudwj.supabase.co/storage/v1/object/public/video-assets/710538a8-48b9-4b62-bf15-ce348d5652d7-b1/scene-12.mp3","speechStartFrame":0,"speechEndFrame":356,"seconds":12.202,"durationInFrames":366,"fromFrame":7859}],"captions":[{"id":1,"sceneId":"scene-1","startSec":0,"endSec":5.333333333333333,"startFrame":0,"endFrame":160,"text":"Sua escola pode rodar perfeitamente e ainda assim aprender"},{"id":2,"sceneId":"scene-1","startSec":5.333333333333333,"endSec":5.833333333333333,"startFrame":160,"endFrame":175,"text":"pouco."},{"id":3,"sceneId":"scene-1","startSec":6.833333333333333,"endSec":10.966666666666667,"startFrame":205,"endFrame":329,"text":"Liderar pedagogicamente é colocar a aprendizagem no centro das"},{"id":4,"sceneId":"scene-1","startSec":10.966666666666667,"endSec":11.566666666666666,"startFrame":329,"endFrame":347,"text":"decisões."},{"id":5,"sceneId":"scene-1","startSec":12.633333333333333,"endSec":15.766666666666667,"startFrame":379,"endFrame":473,"text":"Hoje vou te mostrar exatamente o que isso exige."},{"id":6,"sceneId":"scene-2","startSec":16.1,"endSec":18.333333333333332,"startFrame":483,"endFrame":550,"text":"Quinta-feira, reunião pedagógica."},{"id":7,"sceneId":"scene-2","startSec":18.333333333333332,"endSec":25.966666666666665,"startFrame":550,"endFrame":779,"text":"Você abre com calendário, transporte, faltas, prestação de contas"},{"id":8,"sceneId":"scene-2","startSec":25.966666666666665,"endSec":26.733333333333334,"startFrame":779,"endFrame":802,"text":"do PDDE."},{"id":9,"sceneId":"scene-2","startSec":27.466666666666665,"endSec":29.033333333333335,"startFrame":824,"endFrame":871,"text":"Aí o tempo acaba."},{"id":10,"sceneId":"scene-2","startSec":29.033333333333335,"endSec":32.93333333333333,"startFrame":871,"endFrame":988,"text":"E o ensino, que era o tema, nem entrou"},{"id":11,"sceneId":"scene-2","startSec":33.13333333333333,"endSec":35.1,"startFrame":994,"endFrame":1053,"text":"na conversa."},{"id":12,"sceneId":"scene-2","startSec":35.1,"endSec":36.93333333333333,"startFrame":1053,"endFrame":1108,"text":"Reconhece essa cena?"},{"id":13,"sceneId":"scene-2","startSec":36.93333333333333,"endSec":38.53333333333333,"startFrame":1108,"endFrame":1156,"text":"Quase toda escola vive isso."},{"id":14,"sceneId":"scene-3","startSec":39.166666666666664,"endSec":45.333333333333336,"startFrame":1175,"endFrame":1360,"text":"O urgente grita: bebedouro quebrado, ata atrasada, falta de"},{"id":15,"sceneId":"scene-3","startSec":46.233333333333334,"endSec":46.5,"startFrame":1387,"endFrame":1395,"text":"professor."},{"id":16,"sceneId":"scene-3","startSec":46.5,"endSec":50.2,"startFrame":1395,"endFrame":1506,"text":"O importante é silencioso."},{"id":17,"sceneId":"scene-3","startSec":50.2,"endSec":53.833333333333336,"startFrame":1506,"endFrame":1615,"text":"Um docente repetindo a mesma prática sem efeito não"},{"id":18,"sceneId":"scene-3","startSec":53.833333333333336,"endSec":54.8,"startFrame":1615,"endFrame":1644,"text":"cria problema hoje."},{"id":19,"sceneId":"scene-3","startSec":55.8,"endSec":58.5,"startFrame":1674,"endFrame":1755,"text":"Cria um déficit que aparece lá na frente."},{"id":20,"sceneId":"scene-3","startSec":59.9,"endSec":63.833333333333336,"startFrame":1797,"endFrame":1915,"text":"Sua função é proteger o importante do urgente."},{"id":21,"sceneId":"scene-4","startSec":64.53333333333333,"endSec":68.9,"startFrame":1936,"endFrame":2067,"text":"Liderança pedagógica não é uma frase bonita no projeto"},{"id":22,"sceneId":"scene-4","startSec":68.9,"endSec":69.53333333333333,"startFrame":2067,"endFrame":2086,"text":"da escola."},{"id":23,"sceneId":"scene-4","startSec":70.16666666666667,"endSec":73.13333333333334,"startFrame":2105,"endFrame":2194,"text":"É decisão prática, todo dia."},{"id":24,"sceneId":"scene-4","startSec":73.9,"endSec":77.9,"startFrame":2217,"endFrame":2337,"text":"É olhar para sua agenda, seus critérios, suas reuniões"},{"id":25,"sceneId":"scene-4","startSec":77.9,"endSec":82.76666666666667,"startFrame":2337,"endFrame":2483,"text":"e perguntar: isso aqui está a serviço da aprendizagem"},{"id":26,"sceneId":"scene-4","startSec":82.76666666666667,"endSec":83.43333333333334,"startFrame":2483,"endFrame":2503,"text":"das crianças?"},{"id":27,"sceneId":"scene-4","startSec":84.03333333333333,"endSec":86.66666666666667,"startFrame":2521,"endFrame":2600,"text":"Se não está, algo precisa mudar."},{"id":28,"sceneId":"scene-5","startSec":87.3,"endSec":91.03333333333333,"startFrame":2619,"endFrame":2731,"text":"Liderança pedagógica é visível no cotidiano."},{"id":29,"sceneId":"scene-5","startSec":91.96666666666667,"endSec":95.9,"startFrame":2759,"endFrame":2877,"text":"Você tem uma prioridade de ensino clara e compartilhada"},{"id":30,"sceneId":"scene-5","startSec":95.9,"endSec":96.53333333333333,"startFrame":2877,"endFrame":2896,"text":"com a equipe."},{"id":31,"sceneId":"scene-5","startSec":97.43333333333334,"endSec":101.13333333333334,"startFrame":2923,"endFrame":3034,"text":"Você conhece o que acontece na sala, observando de"},{"id":32,"sceneId":"scene-5","startSec":101.13333333333334,"endSec":101.66666666666667,"startFrame":3034,"endFrame":3050,"text":"verdade."},{"id":33,"sceneId":"scene-5","startSec":101.66666666666667,"endSec":105.9,"startFrame":3050,"endFrame":3177,"text":"E você decide com base em dados de avaliação"},{"id":34,"sceneId":"scene-5","startSec":105.9,"endSec":108.73333333333333,"startFrame":3177,"endFrame":3262,"text":"e produção das crianças, não em achismo."},{"id":35,"sceneId":"scene-5","startSec":109.76666666666667,"endSec":111.7,"startFrame":3293,"endFrame":3351,"text":"Sem isso, é só intenção."},{"id":36,"sceneId":"scene-6","startSec":112.43333333333334,"endSec":118.4,"startFrame":3373,"endFrame":3552,"text":"Erro clássico: chegou o resultado fraco, você convoca todo"},{"id":37,"sceneId":"scene-6","startSec":118.4,"endSec":119.76666666666667,"startFrame":3552,"endFrame":3593,"text":"mundo e cobra empenho."},{"id":38,"sceneId":"scene-6","startSec":120.96666666666667,"endSec":121.23333333333333,"startFrame":3629,"endFrame":3637,"text":"Resultado?"},{"id":39,"sceneId":"scene-6","startSec":122.66666666666667,"endSec":125.66666666666667,"startFrame":3680,"endFrame":3770,"text":"Culpa, defesa e nada muda."},{"id":40,"sceneId":"scene-6","startSec":126.76666666666667,"endSec":127.3,"startFrame":3803,"endFrame":3819,"text":"Vire o jogo."},{"id":41,"sceneId":"scene-6","startSec":128.83333333333334,"endSec":131.93333333333334,"startFrame":3865,"endFrame":3958,"text":"Dado não é tribunal, é bússola."},{"id":42,"sceneId":"scene-6","startSec":133.26666666666668,"endSec":137.43333333333334,"startFrame":3998,"endFrame":4123,"text":"Transforme o número em pergunta pedagógica e a equipe"},{"id":43,"sceneId":"scene-6","startSec":137.43333333333334,"endSec":140.26666666666668,"startFrame":4123,"endFrame":4208,"text":"sai com plano, não com medo."},{"id":44,"sceneId":"scene-7","startSec":140.86666666666667,"endSec":141.83333333333334,"startFrame":4226,"endFrame":4255,"text":"Faça assim."},{"id":45,"sceneId":"scene-7","startSec":142.8,"endSec":146.2,"startFrame":4284,"endFrame":4386,"text":"Apresente os dados separados por área e período."},{"id":46,"sceneId":"scene-7","startSec":146.66666666666666,"endSec":149.63333333333333,"startFrame":4400,"endFrame":4489,"text":"Cada grupo de professores levanta três hipóteses para o"},{"id":47,"sceneId":"scene-7","startSec":149.63333333333333,"endSec":149.9,"startFrame":4489,"endFrame":4497,"text":"que vê."},{"id":48,"sceneId":"scene-7","startSec":150.7,"endSec":155.63333333333333,"startFrame":4521,"endFrame":4669,"text":"Discutam, priorizem e montem um plano com responsável e"},{"id":49,"sceneId":"scene-7","startSec":155.63333333333333,"endSec":155.73333333333332,"startFrame":4669,"endFrame":4672,"text":"prazo."},{"id":50,"sceneId":"scene-7","startSec":156.7,"endSec":159.6,"startFrame":4701,"endFrame":4788,"text":"Depois, marque no calendário a data para revisitar."},{"id":51,"sceneId":"scene-7","startSec":160.46666666666667,"endSec":162.6,"startFrame":4814,"endFrame":4878,"text":"Aí o dado vira movimento real."},{"id":52,"sceneId":"scene-8","startSec":163.36666666666667,"endSec":164.73333333333332,"startFrame":4901,"endFrame":4942,"text":"Pausa pra pensar."},{"id":53,"sceneId":"scene-8","startSec":166,"endSec":167.83333333333334,"startFrame":4980,"endFrame":5035,"text":"Olhe sua última semana de trabalho."},{"id":54,"sceneId":"scene-8","startSec":168.9,"endSec":171.9,"startFrame":5067,"endFrame":5157,"text":"Quanto tempo você de fato dedicou ao que as"},{"id":55,"sceneId":"scene-8","startSec":171.9,"endSec":172.73333333333332,"startFrame":5157,"endFrame":5182,"text":"crianças estão aprendendo?"},{"id":56,"sceneId":"scene-8","startSec":173.63333333333333,"endSec":177.03333333333333,"startFrame":5209,"endFrame":5311,"text":"E quanto foi consumido por demandas administrativas?"},{"id":57,"sceneId":"scene-8","startSec":178.1,"endSec":181.7,"startFrame":5343,"endFrame":5451,"text":"A resposta honesta já te mostra onde está sua"},{"id":58,"sceneId":"scene-8","startSec":181.7,"endSec":183.06666666666666,"startFrame":5451,"endFrame":5492,"text":"liderança pedagógica hoje."},{"id":59,"sceneId":"scene-9","startSec":183.66666666666666,"endSec":185.06666666666666,"startFrame":5510,"endFrame":5552,"text":"Olha a progressão."},{"id":60,"sceneId":"scene-9","startSec":186.03333333333333,"endSec":188.33333333333334,"startFrame":5581,"endFrame":5650,"text":"No começo, tudo depende de você."},{"id":61,"sceneId":"scene-9","startSec":189.4,"endSec":192.16666666666666,"startFrame":5682,"endFrame":5765,"text":"Avança quando a prioridade é compartilhada."},{"id":62,"sceneId":"scene-9","startSec":193.4,"endSec":195.93333333333334,"startFrame":5802,"endFrame":5878,"text":"Cresce quando a equipe analisa os dados junto."},{"id":63,"sceneId":"scene-9","startSec":196.73333333333332,"endSec":199.76666666666668,"startFrame":5902,"endFrame":5993,"text":"E amadurece quando a liderança é distribuída."},{"id":64,"sceneId":"scene-9","startSec":201,"endSec":204.63333333333333,"startFrame":6030,"endFrame":6139,"text":"Numa escola com rotatividade alta como a nossa, isso"},{"id":65,"sceneId":"scene-9","startSec":204.63333333333333,"endSec":207.2,"startFrame":6139,"endFrame":6216,"text":"é o que mantém o foco mesmo quando pessoas"},{"id":66,"sceneId":"scene-9","startSec":207.2,"endSec":207.53333333333333,"startFrame":6216,"endFrame":6226,"text":"mudam."},{"id":67,"sceneId":"scene-10","startSec":208.23333333333332,"endSec":211.06666666666666,"startFrame":6247,"endFrame":6332,"text":"Três movimentos sustentam tudo."},{"id":68,"sceneId":"scene-10","startSec":212.56666666666666,"endSec":216.1,"startFrame":6377,"endFrame":6483,"text":"Proteja tempo pedagógico na agenda com a mesma firmeza"},{"id":69,"sceneId":"scene-10","startSec":216.1,"endSec":217.83333333333334,"startFrame":6483,"endFrame":6535,"text":"de um compromisso inadiável."},{"id":70,"sceneId":"scene-10","startSec":219.06666666666666,"endSec":222.3,"startFrame":6572,"endFrame":6669,"text":"Observe a sala e devolva feedback que apoia, não"},{"id":71,"sceneId":"scene-10","startSec":222.3,"endSec":222.93333333333334,"startFrame":6669,"endFrame":6688,"text":"que julga."},{"id":72,"sceneId":"scene-10","startSec":223.36666666666667,"endSec":228.1,"startFrame":6701,"endFrame":6843,"text":"E construa, de propósito, a liderança de outras pessoas:"},{"id":73,"sceneId":"scene-10","startSec":228.86666666666667,"endSec":232.33333333333334,"startFrame":6866,"endFrame":6970,"text":"coordenação, professores referência, comitê escolar."},{"id":74,"sceneId":"scene-10","startSec":232.96666666666667,"endSec":236.46666666666667,"startFrame":6989,"endFrame":7094,"text":"Aqui o vínculo com a comunidade é sua força."},{"id":75,"sceneId":"scene-11","startSec":237.2,"endSec":238.53333333333333,"startFrame":7116,"endFrame":7156,"text":"Guarda essa."},{"id":76,"sceneId":"scene-11","startSec":239.6,"endSec":243.4,"startFrame":7188,"endFrame":7302,"text":"Se a escola cresce com você e desaba quando"},{"id":77,"sceneId":"scene-11","startSec":243.4,"endSec":247.63333333333333,"startFrame":7302,"endFrame":7429,"text":"você sai, você não construiu liderança pedagógica."},{"id":78,"sceneId":"scene-11","startSec":248.23333333333332,"endSec":249.63333333333333,"startFrame":7447,"endFrame":7489,"text":"Construiu dependência."},{"id":79,"sceneId":"scene-11","startSec":251.5,"endSec":254.33333333333334,"startFrame":7545,"endFrame":7630,"text":"O teste de uma boa gestão é o que"},{"id":80,"sceneId":"scene-11","startSec":254.33333333333334,"endSec":257.93333333333334,"startFrame":7630,"endFrame":7738,"text":"permanece funcionando sem você na sala."},{"id":81,"sceneId":"scene-11","startSec":257.93333333333334,"endSec":261.23333333333335,"startFrame":7738,"endFrame":7837,"text":"Liderança de verdade deixa capacidade instalada."},{"id":82,"sceneId":"scene-12","startSec":261.96666666666664,"endSec":265.5,"startFrame":7859,"endFrame":7965,"text":"Liderança pedagógica se prova na agenda."},{"id":83,"sceneId":"scene-12","startSec":266.3333333333333,"endSec":270.53333333333336,"startFrame":7990,"endFrame":8116,"text":"Então decida agora: qual prioridade de ensino você vai"},{"id":84,"sceneId":"scene-12","startSec":270.53333333333336,"endSec":273.8333333333333,"startFrame":8116,"endFrame":8215,"text":"blindar na sua semana e acompanhar até o fim?"}],"brand":{"primary":"#6D28D9","secondary":"#0EA5E9","background":"#0B1020","font":"Inter, system-ui, sans-serif"},"fps":30,"width":1920,"height":1080,"totalFrames":8225,"showBurnedCaptions":true,"wordHighlight":false}