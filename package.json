{
  "name": "nextjs-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.13.1 <25.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "backfill:embeddings": "node scripts/backfill-embeddings.js",
    "radar:import-censo-catalog": "node scripts/import-censo-catalog.mjs",
    "radar:import-enem": "node scripts/import-enem-escola.mjs",
    "radar:import-ideb": "node scripts/import-ideb.mjs",
    "radar:import-saeb-api": "node scripts/import-saeb-api.mjs",
    "radar:import-saresp": "node scripts/import-saresp.mjs",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "smoke": "node scripts/smoke-test.js",
    "reset:demo": "npx --yes tsx scripts/seed-acme-demo.ts",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:check": "node scripts/i18n-check-keys.mjs",
    "video:probe": "node video-spike/remotion/data/probe-durations.mjs",
    "video:captions:v3": "node video-spike/remotion/data/build-captions-v3.ts",
    "video:preview": "npm run video:probe && npm run video:captions:v3 && remotion studio video-spike/remotion/index.ts",
    "video:render": "npm run video:probe && remotion render video-spike/remotion/index.ts VerthoVideoSpike outputs/vertho-video-spike.mp4",
    "video:render:v2": "npm run video:probe && remotion render video-spike/remotion/index.ts VerthoVideoSpikeV2 outputs/vertho-video-spike-v2.mp4",
    "video:render:v3": "npm run video:probe && npm run video:captions:v3 && remotion render video-spike/remotion/index.ts VerthoVideoSpikeV3 outputs/vertho-video-spike-v3.mp4",
    "test:action-ids": "next build && vitest run tests/unit/security/action-id-exposure.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@breezystack/lamejs": "^1.2.7",
    "@react-pdf/renderer": "^4.4.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.110.7",
    "@trigger.dev/sdk": "4.4.6",
    "@upstash/qstash": "^2.10.1",
    "@vercel/functions": "^3.6.1",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.4",
    "next-intl": "^4.12.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^8.0.3",
    "resend": "^6.12.0",
    "sonner": "^2.0.7",
    "unpdf": "^1.6.0",
    "youtube-dl-exec": "^3.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@remotion/bundler": "^4.0.476",
    "@remotion/cli": "^4.0.476",
    "@remotion/media-parser": "^4.0.476",
    "@remotion/renderer": "^4.0.476",
    "@tailwindcss/postcss": "^4.0.0",
    "@trigger.dev/build": "4.4.6",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "pg": "^8.21.0",
    "remotion": "^4.0.476",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "zod": "4.3.6"
  },
  "overrides": {
    "postcss": "8.5.14",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
