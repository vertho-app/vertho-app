# Vertho Mentor IA — Variáveis de Ambiente
# Copie para .env.local e preencha os valores

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Conexão direta (Session pooler, IPv4) — usada por scripts/apply-migration.mjs
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-N-<regiao>.pooler.supabase.com:5432/postgres

# IA
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-proj-...
# Modelo de fallback OpenAI quando o provider primário falha
OPENAI_FALLBACK_MODEL=gpt-5.4-mini

# Embeddings / RAG
# Provider de embeddings: openai | jina | voyage
EMBEDDING_PROVIDER=openai
JINA_API_KEY=jina_...
VOYAGE_API_KEY=pa-...

# Radar Bett (modelos de IA dedicados ao módulo radar)
RADARBETT_AI_MODEL=claude-sonnet-4-6
RADARBETT_AI_FALLBACK=gemini-3-flash-preview

# WhatsApp (Z-API)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Filas (QStash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...
# Base regional do QStash (publish). Ex: https://qstash.upstash.io
QSTASH_URL=https://qstash.upstash.io

# Email
RESEND_API_KEY=re_...
# Remetente padrão (From) dos emails transacionais
EMAIL_FROM=Vertho <nao-responda@vertho.ai>

# Vídeo (Bunny Stream)
BUNNY_LIBRARY_ID=
BUNNY_PULL_ZONE=
BUNNY_STREAM_API_KEY=
BUNNY_WEBHOOK_SECRET=

# Vídeo IA (Veo + Cloud Run Job de render) — ver cloud-run/video-render/README.md
# Modelo do PLANO (Gemini) e do clipe (Veo)
VIDEO_PLAN_MODEL=gemini-3-flash-preview
VEO_MODEL=veo-3.1-lite-generate-preview
# Disparo do Cloud Run Job a partir do app (Workload Identity Federation — sem chave)
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_REGION=southamerica-east1
GCP_VIDEO_JOB=vertho-video-render
# WIF: pool/provider OIDC que confia na Vercel + SA de trigger personificada
GCP_WIF_POOL=vercel-pool
GCP_WIF_PROVIDER=vercel-oidc
GCP_TRIGGER_SA=vertho-video-trigger@<projeto>.iam.gserviceaccount.com
# VERCEL_OIDC_TOKEN é injetada automaticamente pela Vercel (OIDC Federation ON)

# Scraping
FIRECRAWL_API_KEY=fc-...

# App
NEXT_PUBLIC_ROOT_DOMAIN=vertho.ai
NEXT_PUBLIC_APP_URL=https://app.vertho.ai
NEXT_PUBLIC_APP_WEBHOOK_URL=https://app.vertho.ai
# URL absoluta do app (server-side; usada em links de email/magic-link)
APP_URL=https://app.vertho.ai
# Home institucional no Gamma (apex). Sem isso, '/' cai na home nativa Next.
GAMMA_HOME_URL=
NEXT_PUBLIC_CONTACT_EMAIL=contato@vertho.ai
NEXT_PUBLIC_RODRIGO_WHATSAPP=55119...
CRON_SECRET=

# Segredos internos
# Pepper do hash de OTP — DEDICADO (se ausente, cai no service-role key). Definir!
OTP_PEPPER=
# Auth de chamadas internas server-to-server
INTERNAL_API_KEY=
INTERNAL_DISPATCH_SECRET=

# Sentry (opcional)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# Admin fallback (opcional)
ADMIN_EMAILS=admin@vertho.ai

# Smoke test (scripts/smoke-test.js — opcional, CI)
SMOKE_EMAIL=
SMOKE_PASS=

# Deploy / CI (Vercel — usados pelos workflows do GitHub Actions)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
