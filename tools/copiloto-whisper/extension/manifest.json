{
  "manifest_version": 3,
  "name": "Vertho Whisper Local",
  "version": "1.0.0",
  "description": "Inicia o Whisper local somente quando o Copiloto Vertho solicitar.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "externally_connectable": {
    "matches": [
      "https://app.vertho.ai/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
