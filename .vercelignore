# Pastas grandes que NÃO devem ir pro deploy Vercel
# (afetam tamanho do upload — limite é 1GB)

# ETL local — roda via `npx tsx`, NUNCA executa na Vercel.
# tsconfig já exclui da compilação; web app não importa nada daqui.
# É o grosso do upload (~9GB: parquet/ndjson/logs do radarempresas).
data-pipeline/

# Microdados temporários (importação local)
.tmp_*
/.tmp_enem_2024/
.cache/
outputs/

# Builds locais
/.next/
/out/

# Logs e debug
*.log
npm-debug.log*

# Backups e dumps
*.dump
*.bak
*.zip
*.tar
*.gz
**/backups/

# Editor / IDE
.idea/
.vscode/
*.swp

# Test artifacts
/coverage/
/playwright-report/
/test-results/
