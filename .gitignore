# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# GCP service-account keys (NUNCA comitar)
trigger-key.json
scripts/trigger-key.json
*-sa-key.json
gcp-*.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# script outputs (podem conter PII de migrações ou dumps de dados)
/outputs/
*-dump.json

# radar empresas — dados gerados (Parquet/temp DuckDB nunca vão pro git)
/data-pipeline/radarempresas/out/
/data-pipeline/radarempresas/tmp_duck/
/data-pipeline/**/raw/
*.parquet

# env files
.env*.local
# ...e qualquer SUFIXO depois de `.local`. O padrão acima casa `.env.local`, mas
# não `.env.local.bak`, `.env.local.old`, `.env.local.2026-08-13` — e um backup
# de env é um arquivo de segredos com outro nome. Pego em 13/08/2026 ao copiar
# `.env.local` antes de renomear chaves: o git listou o backup como untracked
# num repositório PÚBLICO. Custo de errar aqui é assimétrico; o padrão é largo
# de propósito.
.env.local*
.env*.local.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
test-results/
playwright-report/
playwright/.auth/

# backups locais
*.zip

# MCP server config (contém API keys)
.mcp.json

# Agent / assistant local state (contém preferências pessoais, logs e artefatos locais)
/.agents/
/.claude/*
# exceção: skills compartilhadas com o time (procedimentos versionados)
!/.claude/skills/
# exceção: subagents, pela mesma razão das skills (é método, não estado local)
!/.claude/agents/
/.codex/

# python bytecode
__pycache__/
*.pyc

data-pipeline/radarempresas/br/out/

data-pipeline/radarempresas/**/_vt/
*.COMT

# logs de pipeline / execução
*.log

# microdados/temp pesados (ENEM, IDEB etc) — nunca vão pro git
.tmp_*/
.tmp/

# backups locais (podem conter PII de colaboradores)
/backups/

/spike-bundle/

# worker de render Hetzner: bundle (artefato) e .env (segredos) nunca vão pro git
worker-hetzner/spike-bundle/
worker-hetzner/.env

# Saídas de medição do Modo Cena: transcrições de cena com contexto de tenant
# (escolas, PPP, personagens reais). O repo é público — nunca entram.
cena-*.json
tri-*.json
triagem-*.json

# Artefatos locais gerados (podem conter PII, áudio, PDFs ou renders pesados)
/tmp/
/output/
/video-spike/tutorial/out/
/.antigravitycli/
.commit-msg-*.txt

# Scripts de diagnóstico da sessão (`scripts/_nome.ts`) e notas de sessão na
# raiz. São utilitários locais: rodam com service-role e leem tabela de PII sem
# filtro de tenant porque quem os roda já escolheu o tenant na mão. Versionar
# 155 deles de uma vez em 29/08 reabriu 5 guards (tenant-read, service-role,
# ia-taskkey, turmas-config, docs-location) e travou o push de todo mundo com
# violações que ninguém tinha introduzido. O estoque antigo segue rastreado e
# allowlistado; o que nasce agora fica local. Doc de engenharia vai em `docs/`.
scripts/_*.ts
scripts/_*.mts
scripts/_*.mjs
/ARQUITETURA.md
/CODEx_SESSION_NOTES.md
/FEATURES-E-BENEFICIOS.md
/PASSO-A-PASSO-VERTHO.md
/RESUMO.md
