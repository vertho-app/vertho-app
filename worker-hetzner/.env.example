# Conexão direta ao Postgres do Supabase (Session pooler) — usada p/ claim/reaper/update.
DATABASE_URL=

# Bunny Stream (upload do mp4 final). Mesma library do app.
BUNNY_LIBRARY_ID=636615
BUNNY_STREAM_API_KEY=

# Gemini — TTS da saudação nominal "Olá, {nome}" (personalização Rota A na box).
# Sem isto, o worker renderiza o deck normalmente mas PULA a personalização.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview  # (opcional; default)
VIDEO_TTS_VOICE=Kore                            # (opcional; default — mesma voz da narração)

# Ajustes (opcionais)
POLL_INTERVAL_MS=15000        # intervalo de poll quando a fila está vazia
REAP_AFTER_MIN=40             # devolve à fila jobs presos em 'rendering' há mais que isso
RENDER_CONCURRENCY=           # frames em paralelo (default = nº de vCPUs)
VIDEO_RENDER_SCALE=0.6666666666666666  # =2/3 → 720p · 1.0=1080p (fallback; o job grava render_scale). O worker faz snap p/ dims inteiras.
COMPOSITION_ID=VerthoVideo

# Supabase — hospeda o WAV do voice-over da saudacao (URL publica p/ o <Audio> do Remotion).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
