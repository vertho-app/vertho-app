# Vertho Mentor IA — Variáveis de Ambiente
# Copie para .env.local e preencha os valores

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Conexão direta (Session pooler, IPv4) — usada por scripts/apply-migration.mjs
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-N-<regiao>.pooler.supabase.com:5432/postgres

# IA
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-proj-...
# Fallback de PROVEDOR do pipeline CENTRAL (Claude sobrecarregado após retries → OpenAI).
# Lido por actions/ai-client.ts. Sem esta env cai no hardcode gpt-5.4.
AI_FALLBACK_MODEL=gpt-5.4-2026-03-05
# ⚠️ Knob SEPARADA e EXCLUSIVA do Radar (lib/radar/*, default gpt-5.1). NÃO afeta o
# fallback central acima — não confundir os dois nomes.
OPENAI_FALLBACK_MODEL=gpt-5.4-mini

# Embeddings / RAG
# Provider de embeddings: openai | voyage | none (default: none → RAG cai pra FTS).
# Produção usa voyage. (JINA_API_KEY abaixo é de SCRAPING, não de embeddings.)
EMBEDDING_PROVIDER=voyage
JINA_API_KEY=jina_...
VOYAGE_API_KEY=pa-...

# Radar Bett (modelos de IA dedicados ao módulo radar)
RADARBETT_AI_MODEL=claude-sonnet-4-6
RADARBETT_AI_FALLBACK=gemini-3-flash-preview

# WhatsApp (Z-API)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Segredo opcional para webhook de desconexão:
# https://app.vertho.ai/api/webhooks/zapi/disconnected?secret=$ZAPI_WEBHOOK_SECRET
ZAPI_WEBHOOK_SECRET=

# Filas (QStash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...
# Base regional do QStash (publish). Ex: https://qstash.upstash.io
QSTASH_URL=https://qstash.upstash.io

# Email
RESEND_API_KEY=re_...
# Remetente padrão (From) dos emails transacionais
EMAIL_FROM=Vertho <nao-responda@vertho.ai>

# Vídeo (Bunny Stream)
BUNNY_LIBRARY_ID=
BUNNY_PULL_ZONE=
BUNNY_STREAM_API_KEY=
BUNNY_WEBHOOK_SECRET=

# Geração de vídeo (avatar HeyGen + Remotion via Hetzner — substituiu o Veo)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=Abigail_expressive_2024112501
RENDER_BACKEND=hetzner
VIDEO_RENDER_SCALE=0.6666666666666666
VIDEO_ROTEIRO_MODE=batch
VIDEO_ROTEIRO_BATCH_POLL_MS=15000
VIDEO_ROTEIRO_BATCH_MAX_POLLS=120

# TTS (áudio/podcast) — Gemini via AI Studio ou Vertex
# Backend: aistudio (usa GEMINI_API_KEY; ⚠️ teto 100/dia no modelo preview) | vertex (cota alta)
TTS_BACKEND=aistudio
# ⚠️ Vertex TTS EXIGE a service account (JSON em base64). No Vercel, a rota
# /api/conteudo/{id}/podcast roda o TTS no runtime → se TTS_BACKEND=vertex e esta var
# faltar, dá 500 "GOOGLE_SERVICE_ACCOUNT_JSON não definido". (A auditoria de env tinha
# a SA só no Trigger.dev — precisou ir pro Vercel também quando o podcast passou a usar Vertex.)
GOOGLE_SERVICE_ACCOUNT_JSON=<base64 do service-account.json (projeto do Vertex)>
GOOGLE_VERTEX_LOCATION=us-central1

# Scraping
FIRECRAWL_API_KEY=fc-...

# App
NEXT_PUBLIC_ROOT_DOMAIN=vertho.ai
NEXT_PUBLIC_APP_URL=https://app.vertho.ai
NEXT_PUBLIC_APP_WEBHOOK_URL=https://app.vertho.ai
# URL absoluta do app (server-side; usada em links de email/magic-link)
APP_URL=https://app.vertho.ai
# Home institucional no Gamma (apex). Sem isso, '/' cai na home nativa Next.
GAMMA_HOME_URL=
NEXT_PUBLIC_CONTACT_EMAIL=contato@vertho.ai
NEXT_PUBLIC_RODRIGO_WHATSAPP=55119...
# Auth dos cron jobs do Vercel (vercel.json). Sem ele, /api/cron é fail-closed 503 em
# prod. ⚠️ NÃO pode ter espaço/newline (Vercel usa como HTTP header e rejeita a build).
# Ao setar via CLI use `printf '%s' "$(...)"`, não `echo`/`console.log` (injetam \n).
CRON_SECRET=

# Token da captura de lead em EVENTO (feira/stand). Só com ele a campanha de
# evento vale: eleva o teto de leads por IP (300/h em vez de 10/h) e grava o
# scope_id próprio. `capturarLeadComercial` é endpoint HTTP — sem token, bastaria
# enviar campanha: 'conarh' para desligar o rate limit do site público.
# Ausente = nenhuma campanha de evento é aceita (cai no padrão). Fail-closed.
LEAD_EVENTO_TOKEN=

# Segredos internos
# Pepper do hash de OTP — DEDICADO (se ausente, cai no service-role key). Definir!
OTP_PEPPER=
# Auth de chamadas internas server-to-server
INTERNAL_API_KEY=
INTERNAL_DISPATCH_SECRET=

# Sentry (opcional)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# Admin fallback (opcional)
ADMIN_EMAILS=admin@vertho.ai

# Smoke test (scripts/smoke-test.js — opcional, CI)
SMOKE_EMAIL=
SMOKE_PASS=

# Deploy / CI (Vercel — usados pelos workflows do GitHub Actions)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
